# VENUS POS backend environment variables.
# Copy to .env for local development (never commit the real .env).

# PostgreSQL connection string (Railway/Fly provide this automatically when a
# Postgres plugin is attached; locally use e.g.
# postgres://postgres:postgres@localhost:5432/venus_pos?sslmode=disable)
DATABASE_URL=postgres://user:password@host:5432/venus_pos?sslmode=disable

# Secret used to sign JWT auth tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# HTTP port the Fiber server listens on
PORT=8080

# Email that is auto-registered as the super admin on first signup
SUPER_ADMIN_EMAIL=Mahmoudraheem76@gmail.com
